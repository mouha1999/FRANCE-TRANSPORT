PORT=3000

# --- Sécurité : à changer ! Jamais dans le code ni dans le navigateur ---
ADMIN_TOKEN=change-moi-par-une-longue-valeur

# --- Marge ---
# markup : prix = coût x (1 + MARGIN)      -> 0.5 = +50% sur le coût (marge réelle 33%)
# margin : prix = coût / (1 - MARGIN)      -> 0.5 = 50% de marge sur le prix (coût x2)
MARGIN=0.5
MARGIN_MODE=markup
TVA=0.2

# --- Limites colis standard (conservatrices, à ajuster selon vos contrats) ---
MAX_WEIGHT=68
MAX_LENGTH=240
MAX_L_PLUS_GIRTH=330

# --- Emails (SMTP : Resend, SendGrid, Brevo, OVH, Gmail...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TransitPro <contact@votre-domaine.fr>"
EXPLOITANT_EMAIL=exploitation@votre-domaine.fr

# --- UPS (developer.ups.com : app + numéro de compte lié pour les tarifs négociés) ---
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT=
UPS_BASE=https://wwwcie.ups.com
UPS_RATING_VERSION=v2409

# --- FedEx (developer.fedex.com) ---
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT=
FEDEX_BASE=https://apis-sandbox.fedex.com

# --- DHL Express MyDHL API (identifiants fournis par votre conseiller DHL) ---
DHL_USER=
DHL_PASSWORD=
DHL_ACCOUNT=
DHL_BASE=https://express.api.dhl.com/mydhlapi/test
DHL_API_VERSION=3.3.1

# --- Estimation des dimensions depuis la photo (optionnel) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
